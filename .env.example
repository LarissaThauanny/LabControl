# Copie este arquivo para .env (nunca envie .env ao GitHub).
APP_ENV=local
# Usar /LabControl/ no XAMPP; / na raiz de dominio de hospedagem.
APP_BASE_PATH=/LabControl/
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=labcontrol
DB_USER=root
DB_PASS=
# Gere em seu proprio computador: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# Token privado para criar o PRIMEIRO administrador em setup.php.
ADMIN_SETUP_TOKEN=
